{
  "name": "threejs-robotics-arms",
  "version": "1.0.0",
  "description": "Three.js robotic-arm workbench with official URDF assets, kinematic motion, collision checks, and physics readouts.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:e2e": "playwright test",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lucide": "^1.16.0",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.10",
    "urdf-loader": "^0.12.7"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "playwright": "^1.60.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
